      "parameters": {
        "jsCode": "const trigger = $('1_Trigger Manually').first().json;\nconst openPOs = $('2_Read - All Open POs').all();\nconst supplierKeys = $('5_Extract - Unique Supplier Email Keys').all();\n\nreturn [{\n  json: {\n    client_code: trigger.client_code,\n    client_company_name: openPOs.length > 0 ? openPOs[0].json.client_company_name : '',\n    run_id: 'RUN_' + new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14),\n    run_timestamp: new Date().toISOString(),\n    trigger_type: 'Manual',\n    open_po_count: openPOs.length,\n    supplier_combinations_found: supplierKeys.length,\n    status: 'Completed',\n    notes: 'All suppliers processed',\n  }\n}];"
