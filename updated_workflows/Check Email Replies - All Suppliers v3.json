    {
      "parameters": {
        "jsCode": "const openPOs = $('2_Read - All Open POs').all().map(i => i.json);\nconst materialMaster = $('4_Read - Material Master').all().map(i => i.json);\n\n// Build a lookup map from supplier_code+material_code to supplier_email_key\nconst lookup = {};\nfor (const row of materialMaster) {\n  const key = `${row.supplier_code}_${row.material_code}`;\n  lookup[key] = {\n    supplier_email_key: row.supplier_email_key,\n    supplier_code: row.supplier_code,\n    supplier_name: row.supplier_name,\n    primary_email: row.primary_emails,\n  };\n}\n\n// Find unique supplier_email_keys across all open POs\nconst seen = new Set();\nconst unique = [];\n\nfor (const po of openPOs) {\n  const lookupKey = `${po.supplier_code}_${po.material_code}`;\n  const match = lookup[lookupKey];\n  if (match && !seen.has(match.supplier_email_key)) {\n    seen.add(match.supplier_email_key);\n    unique.push({ json: match });\n  }\n}\n\nreturn unique;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
