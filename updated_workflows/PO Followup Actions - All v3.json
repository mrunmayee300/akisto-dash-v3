    {
      "parameters": {
        "jsCode": "const allRows = $input.all();\n\n// Collect unique comms_group_ids\nconst seen = new Set();\nconst uniqueGroups = [];\n\nfor (const row of allRows) {\n  const groupId = row.json.comms_group_id;\n  if (groupId && !seen.has(groupId)) {\n    seen.add(groupId);\n    uniqueGroups.push({\n      json: {\n        comms_group_id: groupId,\n        // also pass client_code for downstream logging if needed\n        client_code: row.json.client_code,\n      }\n    });\n  }\n}\n\nreturn uniqueGroups;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        368
      ],
      "id": "b7c249a4-3558-42a7-a5ae-9cdade150cf0",
      "name": "2a_Get - Unique_Groups"
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('1_Trigger Manually').first().json;\nconst client = $('1b_Read - Client list').first().json;\n\nreturn [{\n  json: {\n    client_code: trigger.client_code,\n    client_company_short_name: client.client_company_short_name || client.client_company_name,\n    run_id: 'RUN_' + new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14),\n    run_timestamp: new Date().toISOString(),\n    trigger_type: 'Manual',\n    open_po_count: 0,\n    status: 'No open POs',\n    notes: 'Workflow ran but no open POs found — nothing to process',\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        688
      ],
      "id": "fc637c95-760f-4c3c-beb3-3ab018f7edff",
      "name": "3a_Prepare - Log_Fields"
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('1_Trigger Manually').first().json;\nconst client = $('1b_Read - Client list').first().json;\nconst openPOs = $('1c_Read - All Open POs').all();\nconst uniqueGroups = $('2a_Get - Unique_Groups').all();\n\nreturn [{\n  json: {\n    client_code: trigger.client_code,\n    client_company_short_name: client.client_company_short_name || client.client_company_name,\n    run_id: 'RUN_' + new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14),\n    run_timestamp: new Date().toISOString(),\n    trigger_type: 'Manual',\n    open_po_count: openPOs.length,\n    unique_groups_count: uniqueGroups.length,\n    status: 'Completed',\n    notes: 'All open POs processed successfully',\n  }\n}];"
      },
