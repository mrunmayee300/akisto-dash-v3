NODE_ENV=development
PORT=5001
NODE_VERSION=24.14.1

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=8h
JWT_ISSUER=akisto-api
JWT_AUDIENCE=akisto-client-portal

GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the surrounding quotes when the value contains escaped newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_RANGE=A1:IZ

CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0
API_RATE_LIMIT=1200
LOGIN_RATE_LIMIT=30
COMPANY_LOOKUP_RATE_LIMIT=60

# Optional defense-in-depth token for POST /api/cache/flush.
CACHE_ADMIN_TOKEN=

# Development/migration switches. All must be false in production.
ALLOW_MOCK_DATA=false
ALLOW_LEGACY_QUERY_AUTH=false
ALLOW_LEGACY_PASSWORD_HASHES=false
